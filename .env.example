# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://privytool.com

# Optional analytics — leave blank until you have IDs
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# CV AI — local: put keys in .dev.vars (or .env)
# Cloudflare Preview/Production: set these in Pages → Settings → Environment variables
#
# Groq example:
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
